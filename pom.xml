<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.havocsus</groupId>
    <artifactId>HavocSus</artifactId>
    <version>1.3.1</version>
    <packaging>jar</packaging>
    <name>HavocSus</name>
    <description>Bridges SUS and PremiumVanish: leashed spectator escort for staff investigating flagged players.</description>

    <properties>
        <java.version>21</java.version>
        <!-- Compiling against the 1.21.11 API - the Dialog API needs 1.21.7+. Anything in the 1.21.x line works at runtime
             because plugin.yml declares api-version 1.21. Bump freely. -->
        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Purpur is a Paper fork, so the Paper API is the correct compile target. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          NOTE: SUS and PremiumVanish are deliberately NOT dependencies.
          Both are hooked reflectively at runtime, so this project compiles
          on a clean machine (and in CI) without shipping anyone's paid jar.
        -->
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
